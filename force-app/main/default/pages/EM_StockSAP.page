<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">

    <!-- CSS para forzar que todo ocupe 100% de la pantalla -->
    <style>
        html, body {
            height: 99%;
            margin: 0;
            padding: 0;
        }
        /* Contenedor principal usando flex para repartir espacios */
        #mainContainer {
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        /* Barra superior donde se ubican los botones */
        #topBar {
            height: auto;
        }
        /* Contenedor que crece para ocupar todo el espacio sobrante */
        #contentContainer {
            flex: 1;
            position: relative;
        }
        /* Barra inferior para el enlace */
        #bottomBar {
            height: auto;
            text-align: center;
            padding: 10px;
            background-color: #d1f2eb;
            font-family: Arial, sans-serif;
            font-size: 12px;
            font-weight: bold;
        }        
        /* Ambos div deben ocupar todo el espacio de #contentContainer */
        #divProducto, #divBOM {
            width: 100%;
            height: 100%;
        }
    </style>

    <div id="mainContainer">
        <!-- Sección superior (botones) -->
        <div id="topBar">
            <apex:form >
                <apex:pageBlock >
                    <apex:pageBlockButtons location="top">
                        <apex:commandButton value="Reporte Producto" onclick="showProducto(); return false;" />
                        <apex:commandButton value="Reporte BOM" onclick="showBOM(); return false;" />
                    </apex:pageBlockButtons>
                </apex:pageBlock>
            </apex:form>
        </div>
        
        <!-- Contenido principal (iframes) -->
        <div id="contentContainer">
            <div id="divProducto" style="display:block;">
                <apex:iframe src="https://qsolskbotm3i19u.us.qlikcloud.com/single/?appid=fadf81fe-0e7c-425d-8c98-7854f48def2b&sheet=5057f13b-cc24-4a0c-9b0e-7b1d38952a76&theme=card&opt=ctxmenu,currsel"
                    width="100%" 
                    height="100%"
                    scrolling="auto" 
                    frameborder="0"
                    id="Producto"/>
            </div>
            <div id="divBOM" style="display:none;">
                <apex:iframe src="https://lookerstudio.google.com/embed/reporting/4cdaedd5-76b9-4e36-92fb-7f5598f6a52d/page/86viD"
                    width="100%" 
                    height="100%"
                    scrolling="auto" 
                    frameborder="0"
                    id="BOM"/>
            </div>
        </div>

        <!-- Sección inferior (enlace) -->
        <div id="bottomBar">
            <!-- Abre enlace en nueva pestaña -->
            <apex:outputLink value="https://lureye.us.qlikcloud.com" target="_blank">
                Login Qlik Cloud
            </apex:outputLink>
        </div>
    </div>

    <script>
        function showProducto() {
            document.getElementById('divProducto').style.display = 'block';
            document.getElementById('divBOM').style.display = 'none';
        }
        function showBOM() {
            document.getElementById('divProducto').style.display = 'none';
            document.getElementById('divBOM').style.display = 'block';
        }
    </script>

</apex:page>