    <description>Este flujo notifica al aprobador GE de la partida de presupuesto mediante una notificación personalizada (Custom Notification).
Una vez el aprobador realiza la aprobación, se envía una nueva notificación al propietario del registro para que continúe con el proceso funcional correspondiente, que incluye la actualización de los campos en la partida de presupuesto de manera manual.</description>
    <environments>Default</environments>
    <interviewLabel>Aprobación de Cotización {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Aprobación de Descuento Cotización</label>
    <orchestratedStages>
        <description>Invoca el flujo de envío de notificación al propietario del registro (Partida de Presupuesto).</description>
        <name>Enviar_Aprobacion</name>
        <label>Enviar Aprobación</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <description>Invoca el flujo encargado de notificar al propietario del registro (Owner).</description>
            <name>Enviar_Aprobaci_n_Owner</name>
            <actionName>Subflujo_Enviar_Notificaci_n_Owner</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>VarT_OwnerId</name>
                <value>
                    <elementReference>$Record.Quote.Owner:User.Id</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>VarT_QuoteId</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Enviar Aprobación Owner</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
    </orchestratedStages>
    <orchestratedStages>
        <description>Invoca el subflujo responsable de enviar la notificación al aprobador.</description>
        <name>Enviar_Notificaci_n_Aprobador</name>
        <label>Enviar Notificación Aprobador</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Enviar_Aprobacion</targetReference>
        </connector>
        <exitConditionLogic>and</exitConditionLogic>
        <stageSteps>
            <description>Genera y envía una notificación personalizada (Custom Notification) al aprobador.</description>
            <name>Notificaci_n_de_Aprobaci_n</name>
            <actionName>Subflujo_Enviar_Notificaci_n_Aprobador</actionName>
            <actionType>stepBackground</actionType>
            <canAssigneeEdit>false</canAssigneeEdit>
            <debugSimulateStep>false</debugSimulateStep>
            <entryConditionLogic>and</entryConditionLogic>
            <exitConditionLogic>and</exitConditionLogic>
            <inputParameters>
                <name>VarR_QuoteLineItem</name>
                <value>
                    <elementReference>$Record</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>VarT_AprobadorId</name>
                <value>
                    <elementReference>$Record.GE_AprobadorDescuento__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>VarT_Descuento</name>
                <value>
                    <elementReference>$Record.Descuento__c</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>VarT_QuoteId</name>
                <value>
                    <elementReference>$Record.Id</elementReference>
                </value>
            </inputParameters>
            <label>Notificación de Aprobación</label>
            <requiresAsyncProcessing>false</requiresAsyncProcessing>
            <runAsUser>false</runAsUser>
            <shouldLock>false</shouldLock>
            <stepSubtype>BackgroundStep</stepSubtype>
        </stageSteps>
        <stageSteps>
