    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Existen_Datos_del_Quote_Line_Item</targetReference>
        </connector>
        <filterLogic>(1 AND 3) OR (1 AND 2 AND 3)</filterLogic>
        <filters>
            <field>Descuento__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>25.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Descuento__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>GE_AprobadorDescuento__c</field>
            <operator>IsNull</operator>
            <value>
