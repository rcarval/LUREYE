    <decisions>
        <name>Cual_es_la_unidad_de_negocio</name>
        <label>¿Cual es la unidad de negocio?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Archivos</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Electromec_nica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Unidad_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Electromecánica</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_oportunidad_Electromecanica</targetReference>
            </connector>
            <label>Electromecánica</label>
        </rules>
        <rules>
            <name>Generacion_proyecto</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Unidad_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Generación</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.Familia__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proyecto de Generación</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_oportunidad_Generacion</targetReference>
            </connector>
            <label>Generación Proyecto</label>
        </rules>
        <rules>
            <name>Servicio_Tecnico</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Unidad_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Servicio Técnico</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_oportunidad_Servicio_Tecnico</targetReference>
            </connector>
            <label>Servicio Técnico</label>
        </rules>
        <rules>
            <name>Generacion_Comercial_Industrial</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Unidad_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Generación</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.Familia__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Proyecto de Generación</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_oportunidad_Generaci_n_comercial_Industrial</targetReference>
            </connector>
            <label>Generación Comercial - Industrial</label>
        </rules>
    </decisions>
